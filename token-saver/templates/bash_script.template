#!/bin/bash
# {{description}}
# 自动生成的 Bash 脚本模板
# 生成时间: {{timestamp}}

set -e  # 遇到错误立即退出

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 主函数
main() {
    log_info "开始执行任务..."
    
    # TODO: 在这里添加您的命令
    {% for task in tasks %}
    log_info "执行任务: {{task}}"
    # 示例: {{task}}
    {% endfor %}
    
    log_info "✅ 所有任务执行完成"
}

# 参数处理
while [[ $# -gt 0 ]]; do
    case $1 in
        --verbose|-v)
            set -x  # 显示执行的命令
            shift
            ;;
        --help|-h)
            echo "用法: $0 [选项]"
            echo "选项:"
            echo "  --verbose, -v  显示详细输出"
            echo "  --help, -h     显示帮助信息"
            exit 0
            ;;
        *)
            log_error "未知选项: $1"
            exit 1
            ;;
    esac
done

# 执行主函数
main "$@"
